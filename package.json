{
  "name": "orcs-vs-fairies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ladder": "vitest run --config vitest.ladder.config.ts && python3 scripts/ladder/report.py",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --outfile=dist-cli/rts.js",
    "cli": "node dist-cli/rts.js",
    "build:server": "node scripts/build-server.mjs",
    "server": "node dist-server/rts-server.js",
    "build:tournament": "esbuild src/tournament/main.ts --bundle --platform=node --format=esm --outfile=dist-tournament/run.js",
    "tournament": "node dist-tournament/run.js",
    "test:server": "vitest run tests/server"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
