FROM node:24-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build && npm run build:server
RUN npm prune --omit=dev

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    RTS_HOST=0.0.0.0 \
    RTS_PORT=8787 \
    RTS_DATA_DIR=/data \
    RTS_STATIC_DIR=/app/dist

RUN mkdir -p /data && chown node:node /data
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/dist-server ./dist-server

USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD node --input-type=module -e "const response = await fetch('http://127.0.0.1:' + (process.env.RTS_PORT || '8787') + '/api/health', {signal: AbortSignal.timeout(2500)}); if (!response.ok) process.exit(1);"

CMD ["node", "dist-server/rts-server.js"]
