@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+
+// Run with createNativeContext against the built production index, after root admission.
+// Browser evaluation in that context reads state and coordinates; these actions use native UI.
+export async function runRuinCoverMainSmoke(ctx) {
+ const {page}=ctx,results={};
+ const actor=(state,id)=>{const e=state.entities.find(e=>e.id===id);assert(e,`Actor ${id}`);return e;};
+ const site=(state,id)=>{const s=state.world.sites.find(s=>s.id===id);assert(s,`Site ${id}`);return s;};
+ const visible=(state,p)=>state.visible[state.viewSide].includes(p.level*state.width*state.height+Math.floor(p.y)*state.width+Math.floor(p.x));
+ const recorded=(file,predicate,message)=>assert(file.replay.actions.some(a=>a.type==='command'&&a.side===0&&predicate(a.command)),message);
+ async function load(name){const fixture=await ctx.loadScenario(name);await ctx.pause();return fixture;}
+ async function attack(source,target){
+  await ctx.selectTroop(source);await ctx.closePanels();await ctx.resume();
+  const before=await ctx.snap(),victim=actor(before,target);assert.equal(victim.level,before.viewLevel);assert(visible(before,victim),'Victim visible before native pointer input');
+  await ctx.entityClick(target,'right');
+  await ctx.wait(({source,target})=>{const order=window.rts.state.entities.find(e=>e.id===source)?.order;return order?.type==='attack'&&order.target===target;},{source,target});
+ }
+ async function move(id,point){await ctx.selectTroop(id);await ctx.closePanels();await ctx.resume();await ctx.ground(point,'right');await ctx.wait(id=>window.rts.state.entities.find(e=>e.id===id)?.order.type==='move',id);}
+
+ for(const kind of ['control','covered','other-level','beyond-victim','inside-near-victim']){
+  const name=`ruin-${kind}`,fixture=await load(name),{ids}=fixture,before=await ctx.snap();
+  assert.equal(actor(before,ids.target).hp,actor(before,ids.target).maxHp);
+  await attack(ids.source,ids.target);
+  const after=await ctx.runUntil(s=>actor(s,ids.target).hp<actor(before,ids.target).hp,{label:`${name} first native hit`});
+  const loss=actor(before,ids.target).hp-actor(after,ids.target).hp;
+  assert(Math.abs(loss-ids.expectedFirstDamage)<1e-6,`${name} measured ${loss}, expected ${ids.expectedFirstDamage}`);
+  const native=await ctx.exportAndVerify(`${name}-first-hit`);
+  recorded(native,c=>c.type==='attack'&&c.ids.includes(ids.source)&&c.target===ids.target,`${name} recorded native attack`);
+  assert.equal(native.replay.simulationRevision,'4.0.2');
+  results[name]={loss,tick:after.tick,source:actor(after,ids.source),target:actor(after,ids.target),sites:after.world.sites};
+  ctx.record(`${name} real first hit and complete native round trip/replay`,{loss,tick:after.tick});await ctx.screenshot(`${name}-first-hit`);
+  if(kind==='covered'){
+   await ctx.selectTroop(ids.source);const world=await ctx.openWorld();assert((await world.textContent()).includes('Relic ruins provide ranged cover.'));assert((await world.textContent()).includes(`relic ruins #${ids.sites[0]}`));await ctx.screenshot('ruin-world-tools');
+   await move(ids.source,ids.withdrawal);
+   const hidden=await ctx.runUntil(s=>Math.hypot(actor(s,ids.source).x-ids.withdrawal.x,actor(s,ids.source).y-ids.withdrawal.y)<.6&&!visible(s,site(s,ids.sites[0])),{label:'Owned shooter leaves current relic fog'});
+   const hiddenSave=await ctx.exportSave('ruin-fog-hidden');recorded(hiddenSave,c=>c.type==='move'&&c.ids.includes(ids.source),'Fog check records a native move');await ctx.closeSessions();await ctx.screenshot('ruin-fog-hidden');
+   ctx.record('Current fog hides the same saved relic site',{site:site(hidden,ids.sites[0]),tick:hidden.tick,rendering:'Screenshot needs visual inspection of pillar cleanup.'});
+   await move(ids.source,ids.returnPoint);
+   const revealed=await ctx.runUntil(s=>visible(s,site(s,ids.sites[0]))&&Math.hypot(actor(s,ids.source).x-ids.returnPoint.x,actor(s,ids.source).y-ids.returnPoint.y)<.6,{label:'Owned shooter reveals relic again'});
+   assert.deepEqual(site(revealed,ids.sites[0]),site(hidden,ids.sites[0]));await ctx.screenshot('ruin-fog-revealed');
+   const levels=await ctx.openWorld();await levels.getByLabel('Map level',{exact:true}).selectOption('0');await ctx.wait(()=>window.rts.viewLevel===0);await ctx.screenshot('ruin-off-level');
+   await levels.getByLabel('Map level',{exact:true}).selectOption('1');await ctx.wait(()=>window.rts.viewLevel===1);await ctx.screenshot('ruin-level-restored');
+   ctx.record('Displayed levels switch away from and back to the same ruin',{site:site(revealed,ids.sites[0]),rendering:'Screenshots need visual inspection of pillar cleanup and restoration.'});
+  }
+ }
+ assert.equal(results['ruin-control'].loss,12);assert.equal(results['ruin-other-level'].loss,12);assert.equal(results['ruin-beyond-victim'].loss,12);assert(results['ruin-covered'].loss<results['ruin-control'].loss);assert.equal(results['ruin-inside-near-victim'].loss,results['ruin-covered'].loss);
+
+ const captureFixture=await load('ruin-capture'),{ids}=captureFixture,before=await ctx.snap();
+ assert.equal(site(before,ids.site).owner,null);assert.equal(site(before,ids.site).progress,0);
+ await ctx.selectTroop(ids.worker);await ctx.resume();const world=await ctx.openWorld();await world.getByRole('button',{name:'Capture relic',exact:true}).click();
+ await ctx.wait(({worker,site})=>{const e=window.rts.state.entities.find(e=>e.id===worker);return e?.order.type==='captureSite'&&e.order.target===site;},{worker:ids.worker,site:ids.site});
+ const progressing=await ctx.runUntil(s=>site(s,ids.site).progress>=.3&&site(s,ids.site).progress<.8,{label:'Real relic capture progress'});
+ await ctx.screenshot('ruin-capture-progress');const checkpoint=await ctx.exportAndVerify('ruin-capture-progress');
+ recorded(checkpoint,c=>c.type==='captureSite'&&c.ids.includes(ids.worker)&&c.target===ids.site,'Main World tools records public capture');
+ const captured=await ctx.runUntil(s=>site(s,ids.site).owner===0,{label:'Relic capture completes'});
+ assert.equal(site(captured,ids.site).x,site(before,ids.site).x);assert.equal(site(captured,ids.site).y,site(before,ids.site).y);assert.equal(site(captured,ids.site).level,site(before,ids.site).level);
+ await ctx.exportAndVerify('ruin-captured');await ctx.screenshot('ruin-captured');
+ ctx.record('Main capture button advances, saves, resumes and completes the same ruin',{progressTick:progressing.tick,finalTick:captured.tick,initial:site(before,ids.site),final:site(captured,ids.site),rendering:'Inspect progress-bar and ownership-marker screenshots.'});
+ return {results,capture:{progressTick:progressing.tick,finalTick:captured.tick,initial:site(before,ids.site),final:site(captured,ids.site)},visualAcceptanceRequired:true};
+}
