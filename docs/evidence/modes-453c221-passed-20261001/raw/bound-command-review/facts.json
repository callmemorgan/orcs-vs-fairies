      "lines": [
        {
          "number": 48,
          "text": " await command('natural-matches',[join(prepared.modulesDir,'verify-runtime.mjs')]);"
        },
        {
          "number": 49,
          "text": " checkCancellation();"
        },
        {
          "number": 50,
          "text": " const listeners=execFileSync('ss',['-ltn',`( sport = :${port} )`],{encoding:'utf8'}).trim();"
        },
        {
          "number": 51,
          "text": " assert(!listeners.split('\\n').slice(1).some(Boolean),'Choose an unused proof server port');"
        },
        {
          "number": 52,
          "text": " serverLog=await open(join(logs,'server.log'),'wx');"
        },
        {
          "number": 53,
          "text": " const bundle=join(prepared.serverDir,'rts-server.js');"
        },
        {
          "number": 54,
          "text": " report.server={bundle,bundleSha256:sha(await readFile(bundle)),port};"
        },
        {
          "number": 55,
          "text": " assert.equal(report.server.bundleSha256,prepared.serverFiles['rts-server.js'].sha256);"
        },
        {
          "number": 56,
          "text": " server=spawn(process.execPath,[bundle],{env,stdio:['ignore',serverLog.fd,serverLog.fd]});"
        },
        {
          "number": 57,
          "text": " server.on('error',error=>{serverSpawnError=error;report.server.spawnError=error.message;});report.server.pid=server.pid;await persist();"
        },
        {
          "number": 58,
          "text": " let ready=false;"
        },
        {
          "number": 59,
          "text": " for(let attempt=0;attempt<80;attempt++) {"
        },
        {
          "number": 60,
          "text": "  checkCancellation();"
        },
        {
          "number": 61,
          "text": "  if(serverSpawnError)throw serverSpawnError;"
        },
        {
          "number": 62,
          "text": "  assert(server.exitCode===null&&server.signalCode===null,'Owned server exited before readiness');"
        },
        {
          "number": 63,
          "text": "  try {if((await fetch(base)).status===200){ready=true;break;}}catch{}"
        },
        {
          "number": 64,
          "text": "  await pause(250);"
        },
        {
          "number": 65,
          "text": " }"
        },
        {
          "number": 66,
          "text": " assert(ready,'Owned proof server did not become ready');"
        },
        {
          "number": 67,
          "text": " assert(server.exitCode===null&&server.signalCode===null,'Owned server must remain alive after readiness');"
        },
        {
          "number": 68,
          "text": " await command('main-browser',['scripts/verify_assembled_modes.mjs',base,sourcePin,join(out,'browser')]);"
        },
        {
          "number": 69,
          "text": " for(const name of ['local-custom-hill.session','local-build-report.session'])await command(`native-${name}`,"
        },
        {
          "number": 70,
          "text": "  [join(prepared.modulesDir,'verify-native.mjs'),join(out,'browser',`${name}.json`),join(out,'native',`${name}.verification.json`),sourcePin]);"
        },
        {
          "number": 71,
          "text": " checkCancellation();"
        },
        {
          "number": 72,
          "text": " assert(server.exitCode===null&&server.signalCode===null&&!serverSpawnError,'Owned server must remain alive until planned shutdown');"
        },
        {
          "number": 73,
          "text": " report.server.aliveBeforePlannedShutdown=true;"
        },
        {
          "number": 74,
          "text": " report.result='passed';"
        },
        {
          "number": 75,
          "text": "} catch(error){failure=error;report.result='failed';report.failure={message:error.message,stack:error.stack};}"
        },
        {
          "number": 76,
          "text": "finally {"
        },
        {
          "number": 77,
          "text": " if(server?.pid&&server.exitCode===null&&server.signalCode===null) {"
        },
        {
          "number": 78,
          "text": "  const exited=new Promise(resolve=>server.once('exit',resolve));server.kill('SIGTERM');"
        },
        {
          "number": 79,
          "text": "  await Promise.race([exited,pause(5000)]);"
        },
        {
          "number": 80,
          "text": "  if(server.exitCode===null&&server.signalCode===null){server.kill('SIGKILL');await exited;}"
        }
      ]
