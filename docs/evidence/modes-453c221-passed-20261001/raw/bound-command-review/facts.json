      "lines": [
        {
          "number": 134,
          "text": "export function observePage(page,report,context) {"
        },
        {
          "number": 135,
          "text": "  for(const key of ['pageErrors','consoleErrors','failedRequests','httpErrors'])report[key]??=[];"
        },
        {
          "number": 136,
          "text": "  context.observedReports.add(report);"
        },
        {
          "number": 137,
          "text": "  page.on('pageerror',error=>report.pageErrors.push(error.message));"
        },
        {
          "number": 138,
          "text": "  page.on('console',message=>{if(message.type()==='error')report.consoleErrors.push(message.text());});"
        },
        {
          "number": 139,
          "text": "  page.on('requestfailed',request=>report.failedRequests.push({url:request.url(),failure:request.failure()}));"
        },
        {
          "number": 140,
          "text": "  page.on('response',response=>{"
        },
        {
          "number": 141,
          "text": "    if(response.status()>=400)report.httpErrors.push({url:response.url(),status:response.status()});"
        },
        {
          "number": 142,
          "text": "    const url=new URL(response.url());"
        },
        {
          "number": 143,
          "text": "    if(url.origin!==new URL(context.base).origin||response.status()!==200)return;"
        },
        {
          "number": 144,
          "text": "    const path=decodeURIComponent(url.pathname==='/'?'index.html':url.pathname.slice(1));"
        },
        {
          "number": 145,
          "text": "    if(!/\\.(html|js|css)$/.test(path)||!context.compiledFiles[path])return;"
        },
        {
          "number": 146,
          "text": "    const task=(async()=>{"
        },
        {
          "number": 147,
          "text": "      const bytes=await response.body(),digest=sha(bytes),expected=context.compiledFiles[path];"
        },
        {
          "number": 148,
          "text": "      assert.equal(digest,expected.sha256,`Served bytes differ from compiled ${path}`);"
        },
        {
          "number": 149,
          "text": "      context.servedAssets[url.pathname]={path,sha256:digest,bytes:bytes.length,status:response.status()};"
        },
        {
          "number": 150,
          "text": "    })().catch(error=>report.pageErrors.push(`Asset provenance: ${error.message}`));"
        },
        {
          "number": 151,
          "text": "    context.responseTasks.push(task);"
        },
        {
          "number": 152,
          "text": "  });"
        }
      ]
    },
