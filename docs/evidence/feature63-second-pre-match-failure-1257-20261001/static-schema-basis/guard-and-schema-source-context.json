              "text": "def inventory(records, root, complete=False):"
            },
            {
              "number": 212,
              "text": "    root = Path(root)"
            },
            {
              "number": 213,
              "text": "    require(root.is_absolute() and root.resolve() == root and not root.is_symlink(), 'Inventory root is noncanonical')"
            },
            {
              "number": 214,
              "text": "    seen = set()"
            },
            {
              "number": 215,
              "text": "    for row in records:"
            },
            {
              "number": 216,
              "text": "        relative = Path(row['path'])"
            },
            {
              "number": 217,
              "text": "        require(not relative.is_absolute() and '..' not in relative.parts and row['path'] not in seen, 'Inventory path is invalid or duplicate')"
            },
            {
              "number": 218,
              "text": "        path = root / relative"
            },
            {
              "number": 219,
              "text": "        bound({'path': str(path), 'bytes': row['bytes'], 'sha256': row['sha256']}, MAX_RAW_BYTES)"
            },
            {
              "number": 220,
              "text": "        require(stat.S_IMODE(path.stat().st_mode) == row['mode'], 'Inventory mode differs')"
            },
            {
              "number": 221,
              "text": "        seen.add(row['path'])"
            },
            {
              "number": 222,
              "text": "    if complete:"
            },
            {
              "number": 223,
              "text": "        actual = set()"
            },
            {
              "number": 224,
              "text": "        for path in root.rglob('*'):"
            },
            {
              "number": 225,
              "text": "            require(not path.is_symlink(), 'Symlink in complete inventory')"
            },
            {
              "number": 226,
              "text": "            if path.is_file():"
            },
            {
              "number": 227,
              "text": "                actual.add(path.relative_to(root).as_posix())"
            },
            {
              "number": 228,
              "text": "        require(actual == seen, 'Complete inventory filename set differs')"
            },
            {
              "number": 229,
              "text": "    return seen"
            },
