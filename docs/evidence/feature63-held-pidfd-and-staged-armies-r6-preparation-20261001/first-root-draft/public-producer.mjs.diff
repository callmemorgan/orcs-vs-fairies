+function ownedCombatActors(profile) {
+  const frame = profile.latest;
+  if (!frame) return [];
+  const eligibility = profile.frameIndex.findLast(value => value.tick === frame.message.tick);
+  const eligibleIds = new Set(eligibility?.eligibleOwnIds ?? []);
+  return frame.message.view.entities.filter(entity => eligibleIds.has(entity.id));
+}
+function armyAtCommonHq(profile, hq) {
+  const army = ownedCombatActors(profile);
+  return army.length > 0 && army.every(entity => (entity.level ?? 0) === (hq.level ?? 0) && Math.hypot(entity.x - hq.x, entity.y - hq.y) <= 8);
+}
+async function holdArmy(profile, commonHqId, reason) {
