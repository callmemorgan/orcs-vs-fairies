+  const selectedIds = await page.evaluate(() => [...window.rts.selected]);
+  assert.ok(selectedIds.length > 0, 'Ordinary hold needs a selected owned combat army.');
+  const eligibleIds = new Set(ownedCombatActors(profile).map(entity => entity.id));
+  assert.ok(selectedIds.every(id => eligibleIds.has(id)), 'Ordinary hold selection must be observed eligible owned combat actors.');
+  const priorOrdinal = profile.wireOrdinal;
+  await ui(profile, 'keyboard', {key: 'h', purpose: 'ordinary hold position', commonHqId, reason, selectedIds}, () => page.keyboard.press('h'));
+  const commandRow = await waitUntil(() => profile.commands.find(row => row.wireOrdinal > priorOrdinal), 5_000, 'Hold key sent no command.');
+  const command = commandRow.message;
+  assert.equal(command.command.type, 'hold', 'The ordinary Hold key must send a genuine hold command.');
+  assert.deepEqual([...command.command.ids].sort((a, b) => a - b), [...selectedIds].sort((a, b) => a - b));
+  const ackRow = await waitUntil(() => profile.acks.find(row => row.socketId === commandRow.socketId && row.message.clientSeq === command.clientSeq), 10_000, 'Hold command has no acknowledgement.');
+  assert.equal(ackRow.message.accepted, true); assert.ok(Number.isSafeInteger(ackRow.message.appliedTick));
+  const frame = await waitUntil(() => {
+    const current = profile.latest;
+    if (!current || current.message.tick < ackRow.message.appliedTick) return null;
+    const living = current.message.view.entities.filter(entity => selectedIds.includes(entity.id) && entity.side === profile.side && entity.hp > 0);
+    return living.every(entity => entity.order?.type === 'hold') ? current : null;
+  }, 5_000, 'Acknowledged hold was not observed for surviving selected own actors.');
+  status('ordinary-hold-observed', {profile: profile.name, side: profile.side, reason, selectedIds, clientSeq: command.clientSeq, commandWireOrdinal: commandRow.wireOrdinal, ackWireOrdinal: ackRow.wireOrdinal, appliedTick: ackRow.message.appliedTick, observedTick: frame.message.tick});
