   async function hit(id,target){const before=await ctx.snap(),hp=actor(before,target).hp;await attack(id,target);const after=await ctx.runUntil(s=>actor(s,target).hp<hp,{timeout:30000,label:`real hit ${id}→${target}`});return {before,after,damage:hp-actor(after,target).hp};}
   async function move(id,p){await select(id);await ctx.ground(p,'right');return ctx.runUntil(s=>near(actor(s,id),p),{timeout:60000,label:`native movement ${id}`});}
   async function checkpoint(name,featureIds,scenario){await ctx.pause();const file=await ctx.exportAndVerify(name);await ctx.pause();receipt.checkpoints.push({name,scenario,featureIds,tick:file.game.state.tick,gameSha256:digest(JSON.stringify(file.game))});return file;}
-  async function hostileRendering(name,file,center,id,decoy){await ctx.openSessions('replay');await ctx.sessions.getByLabel('Import replay JSON',{exact:true}).setInputFiles(resolve(ctx.out,`${name}-replay.json`));await ctx.sessions.getByRole('button',{name:'Import replay',exact:true}).click();await ctx.wait(()=>window.rts.mode==='replay',null,60000);await ctx.ready();await ctx.sessions.getByLabel('Replay tick',{exact:true}).press('End');await ctx.wait(tick=>window.rts.state.tick===tick,file.game.state.tick,60000);await ctx.sessions.getByLabel('Replay perspective',{exact:true}).selectOption('1');await ctx.wait(()=>window.rts.viewSide===1);await ctx.closeSessions();await ctx.selectTroop(center);const observed=ctx.observeNative(file,1);assert(!observed.ids.includes(id));assert(observed.ids.includes(decoy));const trueActor=actor(file.game.state,id);assert(observed.visible.includes(Math.floor(trueActor.y)*file.game.state.width+Math.floor(trueActor.x)),'Hidden troop tile is visible; this is concealment beyond fog');await ctx.wait(expected=>window.rts.art.renderedUnits===expected,observed.renderedUnits);await ctx.screenshot('factions-fairies-hostile-grove');record('Native hostile replay rendering shows the decoy and conceals the real troop',[24],{trueTroop:id,decoy,renderedUnits:observed.renderedUnits});await ctx.importSave(resolve(ctx.out,`${name}-save.json`),'grove original after hostile rendering');await ctx.closeSessions();await ctx.pause();}
+  async function hostileRendering(name,file,center,id,decoy){await ctx.openSessions('replay');await ctx.sessions.getByLabel('Import replay JSON',{exact:true}).setInputFiles(resolve(ctx.out,`${name}-replay.json`));await ctx.sessions.getByRole('button',{name:'Import replay',exact:true}).click();await ctx.wait(()=>window.rts?.mode==='replay',null,60000);await ctx.ready();await ctx.sessions.getByLabel('Replay tick',{exact:true}).press('End');await ctx.wait(tick=>window.rts.state.tick===tick,file.game.state.tick,60000);await ctx.sessions.getByLabel('Replay perspective',{exact:true}).selectOption('1');await ctx.wait(()=>window.rts.viewSide===1);await ctx.closeSessions();await ctx.selectTroop(center);const observed=ctx.observeNative(file,1);assert(!observed.ids.includes(id));assert(observed.ids.includes(decoy));const trueActor=actor(file.game.state,id);assert(observed.visible.includes(Math.floor(trueActor.y)*file.game.state.width+Math.floor(trueActor.x)),'Hidden troop tile is visible; this is concealment beyond fog');await ctx.wait(expected=>window.rts.art.renderedUnits===expected,observed.renderedUnits);await ctx.screenshot('factions-fairies-hostile-grove');record('Native hostile replay rendering shows the decoy and conceals the real troop',[24],{trueTroop:id,decoy,renderedUnits:observed.renderedUnits});await ctx.importSave(resolve(ctx.out,`${name}-save.json`),'grove original after hostile rendering');await ctx.closeSessions();await ctx.pause();}
   async function build(name,definition,worker,destination,featureIds,prefix,scenario){await checkpoint(`${prefix}-before-build`,featureIds,scenario);const before=await ctx.snap();await action(name,worker,{destination});let after=await ctx.snap();const created=after.entities.find(e=>e.side===0&&e.definitionId===definition&&e.progress<1&&near(e,destination,.1));assert(created,'Native foundation created');const cost=ctx.manifest.scenarios[scenario].authored.structureCosts?.[definition];assert(cost,'Declared native structure cost');for(const kind of ['wood','ore','crystal'])assert.equal(bank(before)[kind]-bank(after)[kind],cost[kind]);await checkpoint(`${prefix}-foundation`,featureIds,scenario);after=await ctx.runUntil(s=>live(s,created.id)?.progress===1,{timeout:90000,label:`complete ${definition}`});const complete=await checkpoint(`${prefix}-complete`,featureIds,scenario);receipt.continuations.push([`${prefix}-foundation`,`${prefix}-complete`]);record(`${name} pays its full cost and completes through native worker construction`,featureIds,{id:created.id,cost});return {id:created.id,file:complete,state:after};}
 
